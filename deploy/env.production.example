APP_NAME=MindEase
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.mindease.me
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mindease
DB_USERNAME=mindease
DB_PASSWORD=

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Password reset mail - use Amazon SES in ap-southeast-2 (Sydney) so data stays in AU.
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.ap-southeast-2.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@mindease.me"
MAIL_FROM_NAME="MindEase"

MINDEASE_ACCESS_TTL_MINUTES=15
MINDEASE_REFRESH_TTL_DAYS=60
MINDEASE_RESET_URL="mindease://reset-password?token={token}&email={email}"
MINDEASE_VIDEO_CAP_ENABLED=false
# true only on staging: opens /docs/api and /developers for the mobile developer
MINDEASE_DEVELOPER_DOCS=false

# Bookings (placeholders until the client confirms pricing / refund rules)
MINDEASE_BOOKING_PRICE_CENTS=15000
MINDEASE_SESSION_MINUTES=50
MINDEASE_REFUND_CUTOFF_HOURS=24

# Stripe (live keys only in production; webhook URL: https://api.mindease.me/v1/webhooks/stripe)
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Zoom Video SDK (in-app calls) - never ship these in the app
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=

# Web panel (mindease-web). Origin allowed by CORS.
CORS_ALLOWED_ORIGINS=https://app.mindease.me
